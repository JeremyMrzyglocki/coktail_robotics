# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=
# Shared secret the robot runner uses to claim jobs and report results.
ROBOT_SHARED_SECRET=change-me-before-the-demo
# Which model provider the compiler and the prop designer use: anthropic or openai.
# Unset = whichever key is present.
LLM_PROVIDER=anthropic
# Model used by the skill compiler. Measured with tools/compile_eval.py (13 prompts x 2):
# claude-opus-5-5 at low effort with fast mode gave 26/26 valid plans, median 10.3 s;
# gpt-4.1 gave 12/13, median 6.5 s.
COMPILER_MODEL=claude-opus-5-5
# Optional: a separate model for stage 1 ("act it out" -- turning the request into
# hand movements, the reasoning-heavy half). Unset = COMPILER_MODEL.
COMPILER_ACT_MODEL=claude-opus-5-5
# Model for repair rounds only (first attempt stays on COMPILER_MODEL)
REPAIR_MODEL=claude-opus-5-5
# Anthropic only. Effort: low | medium | high (default medium). low halved the wait
# and kept every plan valid.
COMPILER_EFFORT=low
# Anthropic only. fast = the same model generating ~2.5x faster at 2x the token price;
# the wait is almost all output, so this is the latency knob. Unset = standard speed.
COMPILER_SPEED=fast
# sqlite file
SKILLSTORE_DB=data/skillstore.db
# To use OpenAI instead: LLM_PROVIDER=openai, COMPILER_MODEL=gpt-4.1-mini,
# COMPILER_ACT_MODEL=gpt-4.1, REPAIR_MODEL=gpt-4.1.
OPENAI_API_KEY=
