# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=
# Shared secret the robot runner uses to claim jobs and report results.
ROBOT_SHARED_SECRET=change-me-before-the-demo
# Model used by the skill compiler.
COMPILER_MODEL=gpt-4.1-mini
# Optional: a separate model for stage 1 ("act it out" -- turning the request into
# hand movements, the reasoning-heavy half). Binding to the catalog keeps using
# COMPILER_MODEL. Measured with tools/compile_eval.py: gpt-4.1 here gave more
# valid plans than gpt-4.1-mini, at the same or lower latency. Unset = COMPILER_MODEL.
COMPILER_ACT_MODEL=gpt-4.1
# sqlite file
SKILLSTORE_DB=data/skillstore.db
# Either provider works; whichever key is present wins.
OPENAI_API_KEY=
LLM_PROVIDER=openai
